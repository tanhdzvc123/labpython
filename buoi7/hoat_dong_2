
DON_GIA = 50000

print("CHƯƠNG TRÌNH QUẢN LÝ ĐẶT HÀNG")

while True:
    try:
        so_luong = int(input("Nhap so luong (so nguyen duong): "))
        if so_luong > 0:
            break
        print("So luong phai lon hon 0, vui long nhap lai.")
    except ValueError:
        print("Du lieu khong hop le, vui long nhap lai mot so nguyen.")

tong_tien = so_luong * DON_GIA

print("-" * 35)
print("So luong hop le da nhap:", so_luong)
print(f"Don gia: {DON_GIA:,} VNĐ")
print(f"Tong thanh toan: {tong_tien:,} VNĐ")
print("CẢM ƠN BẠN ĐÃ MUA HÀNG")